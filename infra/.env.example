# ─────────────────────────────────────────────────────────────
# .env.example — bud-tack-infra, local environment
#
# Usage:  cp .env.example .env
# Never commit .env. Staging and production values live only in the
# deployment platform's secret store (10-devops/environments.md).
# These defaults match bud-tack-docs/.env.example, so DATABASE_URL and
# MIGRATOR_DATABASE_URL in bud-tack-api and bud-tack-db work unchanged.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL superuser — used only by the container's first start ─
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres-local-only

# ── The one database of the application ─────────────────────────────
POSTGRES_DB=app_dev
POSTGRES_PORT=5432

# ── Roles (00-governance/security-policy.md — least privilege) ──────
# bud_tack_migrator owns the database and runs DDL (bud-tack-db).
# bud_tack_app connects as the API and can never create or drop objects.
BUD_TACK_MIGRATOR_PASSWORD=dev
BUD_TACK_APP_PASSWORD=dev

# ── The whole application (docker compose --profile app) ──────────
# The one tag both images carry (10-devops/ci-cd.md): the commit or release.
APP_TAG=local
# The browser's only way in: http://localhost:8080 (ADR-006).
PORTAL_PORT=8080
# Where the other repositories are cloned, relative to this one. The
# defaults assume them side by side (10-devops/local-setup.md, step 1).
DB_SOURCE=../bud-tack-db
API_SOURCE=../bud-tack-api
PORTAL_SOURCE=../bud-tack-portal
