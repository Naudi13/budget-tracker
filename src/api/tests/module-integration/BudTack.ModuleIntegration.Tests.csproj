<Project Sdk="Microsoft.NET.Sdk">

  <!-- Calls each module through its public API only, against a real PostgreSQL
       (11-quality/testing-strategy.md). References the modules, never the host. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BudTack.Identity\BudTack.Identity.csproj" />
    <ProjectReference Include="..\..\src\BudTack.Transactions\BudTack.Transactions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\schema\budtack.sql" Link="schema.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
