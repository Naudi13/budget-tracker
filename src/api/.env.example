# ─────────────────────────────────────────────────────────────
# .env.example — bud-tack-api, local environment
#
# Usage:  cp .env.example .env
# Never commit .env. Staging and production inject these values from the
# deployment platform's secret store (10-devops/environments.md).
# Defaults match bud-tack-docs/.env.example and bud-tack-infra's PostgreSQL.
# ─────────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
# Kestrel reads ASPNETCORE_URLS, not APP_PORT; 3000 is the port every
# example URL and API contract uses.
ASPNETCORE_URLS=http://localhost:3000

# ── Database — the API's own role, never the migrator's ────────
DATABASE_URL=postgresql://bud_tack_app:dev@localhost:5432/app_dev

# ── Auth — the bearer token of POST /sessions (identity.yaml) ──
# HS256 key: at least 32 bytes. Local only; staging and production get their
# own from the secret store. Changing it signs every user out.
AUTH_JWT_SECRET=local-only-change-me-0123456789abcdef
AUTH_JWT_EXPIRY_SECONDS=3600

# The one origin allowed to call the API across origins (ADR-008).
CORS_ALLOWED_ORIGIN=http://localhost:8080
