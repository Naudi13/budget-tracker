# bud-tack-portal — serves the Angular files and forwards /api/ and /health to
# the API on the same origin, so the browser never makes a cross-origin call
# (ADR-006). ${API_ORIGIN} and ${NGINX_LOCAL_RESOLVERS} are filled in when the
# container starts; every other $variable is nginx's own.

# Docker's DNS, re-read every 10 s: the API can start after the portal, or be
# replaced, without restarting nginx.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    set $api ${API_ORIGIN};

    location /api/ {
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 1m;
    }

    location = /health {
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # File names carry a content hash: cache them for a year.
    location ~* \.(?:js|css|woff2?|ico|png|svg|webp)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Every other path is an Angular route: answer with index.html, never cached.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
    }
}
