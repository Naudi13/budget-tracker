# ─────────────────────────────────────────────────────────────
# .env.example — bud-tack-db, local environment
#
# Usage:  cp .env.example .env
# Never commit .env. Staging and production inject MIGRATOR_DATABASE_URL
# from the deployment platform's secret store (10-devops/environments.md).
# The default matches the local PostgreSQL started by bud-tack-infra.
# ─────────────────────────────────────────────────────────────

# The migrator role may run DDL; the API's role (DATABASE_URL) may not.
MIGRATOR_DATABASE_URL=postgresql://bud_tack_migrator:dev@localhost:5432/app_dev
