# ─────────────────────────────────────────────────────────────
# .env.example — local development environment variables
#
# Usage:  cp .env.example .env   then fill .env with your own local values.
# Never commit .env. Staging and production values live only in the
# deployment platform's secret store, never in a file inside this repo.
# ─────────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
APP_NAME=bud-tack
ASPNETCORE_URLS=http://localhost:3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=debug
# No CORS setting: the portal reaches the API through a same-origin proxy
# (ADR-006), so the API refuses every cross-origin request.

# ── Database (single database, shared by the whole application) ─
# Both roles are created by bud-tack-infra's docker compose.
DATABASE_URL=postgresql://bud_tack_app:dev@localhost:5432/app_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false
# Used only by bud-tack-db's BudTack.Db.Migrations (FluentMigrator), never by
# the API: the migrator role may run DDL, the application's role may not.
MIGRATOR_DATABASE_URL=postgresql://bud_tack_migrator:dev@localhost:5432/app_dev

# ── Auth (validated once, in-process, at the edge of the request) ─
# Bearer JWT only — see 07-api/contracts/openapi/identity.yaml; there is no
# session cookie.
AUTH_JWT_SECRET=replace-with-a-long-random-local-only-string
AUTH_JWT_EXPIRY_SECONDS=3600
# The one origin allowed to call the API across origins (ADR-008).
CORS_ALLOWED_ORIGIN=http://localhost:8080

# ── Observability ────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=bud-tack-api
SENTRY_DSN=

# ── Local-only stubs for external providers ──────────────────────
# EXTERNAL_PROVIDER_URL=http://localhost:4000
# EXTERNAL_PROVIDER_API_KEY=local-dev-key
